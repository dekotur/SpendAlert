# Required: create a bot with https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Required: generate with `python scripts/generate_key.py`.
# Keep this value stable. Changing it makes existing encrypted rows unreadable.
DB_ENCRYPTION_KEY=

# Optional: enables the /ai assistant. The rest of the bot works without it.
# Create a key in your own OpenRouter account.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Optional: Telegram chat ID that receives operational alerts.
ADMIN_CHAT_ID=

# Optional application settings. Uncomment only when needed.
# DATABASE_URL=sqlite:///spendalert.db
# SPENDALERT_DATA_DIR=./data
# DB_THREAD_POOL_WORKERS=32
# BOT_DISK_BUDGET_MB=0
# DISK_FREE_ALERT_THRESHOLD_MB=1024
